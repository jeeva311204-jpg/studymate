# StudyMate Environment Configuration Template

# Server Port
PORT=5000

# MongoDB Connection String (leave empty or default to use in-memory/local)
# Example local: mongodb://127.0.0.1:27017/studymate
# Example Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/studymate
MONGODB_URI=mongodb://127.0.0.1:27017/studymate

# JWT Authentication Secret
JWT_SECRET=CHANGE_ME

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Model for AI image generation (e.g. gemini-3.1-flash-lite-image). Must be set only after the model has been tested on your API key.
GEMINI_IMAGE_MODEL=
MAX_NOTE_CHARACTERS=100000

# Frontend Application URL
CLIENT_URL=http://localhost:5173
